    "admin": {
      "storageState": {
        "cookies": [
          {
            "name": "demo_session",
            "value": "demo-admin",
            "domain": "127.0.0.1",
            "path": "/",
            "expires": -1,
            "httpOnly": true,
            "secure": false,
            "sameSite": "Lax"
          }
        ],
        "origins": [
          {
            "origin": "http://127.0.0.1:4173",
            "localStorage": [
              {
                "name": "demo_user",
                "value": "admin"
              }
            ]
          }
        ]
      },
      "sessionStorage": {
        "http://127.0.0.1:4173": {
          "demo_tenant": "local-tenant"
        }
      },
      "api": {
        "headers": {
          "Authorization": "Bearer demo-admin"
        }
      }
    },
