{
  "name": "automation-tests",
  "version": "0.1.1",
  "private": true,
  "description": "Agent-friendly multi-target API and Chromium tests with externally supplied authentication state",
  "scripts": {
    "test": "node --import tsx scripts/run.ts",
    "test:api": "node --import tsx scripts/run.ts --suite api",
    "test:web": "node --import tsx scripts/run.ts --suite web",
    "test:unit": "node --import tsx --test verification/unit/*.test.ts",
    "verify:failure": "node --import tsx verification/check-failure-artifacts.ts",
    "verify:state": "node --import tsx --test verification/state-tests/*.test.ts",
    "verify:interrupt": "node --import tsx --test verification/interruption/check.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "target:new": "node --import tsx scripts/create-target.ts",
    "schema": "node --import tsx scripts/export-schema.ts",
    "demo:server": "node --import tsx scripts/demo-server.ts",
    "install:browser": "playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
